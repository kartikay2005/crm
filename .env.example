# Copy this file to .env and fill in real values before running.
# Never commit a real .env — it's excluded from version control on purpose.

ENV=local
APP_NAME=ai-crm-assistant
VERSION=2.0.0
DEBUG=false

# --- Database ---------------------------------------------------------------
# SQLite is fine for local dev only. staging/prod MUST use Postgres — this
# is enforced by a validator in core/config.py, not just a suggestion.
DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql+psycopg://crm:crm@localhost:5432/crm

# --- Security / JWT -----------------------------------------------------
# Generate a real one for anything beyond local dev:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-change-me-32-chars-minimum

# --- Field encryption (PII columns) -------------------------------------
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Redis (rate limiting) -----------------------------------------------
# Leave blank to disable rate limiting (fine for local dev).
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

# --- Seller data source ---------------------------------------------------
# "sql" (default) reads sellers from a marketplace system-of-record DB view
# that only exists in a real deployment — it will NOT work against the local
# SQLite dev database. For local dev, use "csv" against the demo data
# generated by `python3 scripts/generate_demo_sellers.py`:
DATA_SOURCE_KIND=csv
# DATA_SOURCE_KIND=sql
SELLER_CSV_PATH=data/sellers.csv

# --- Dataset Intelligence Engine -----------------------------------------
DATASET_UPLOAD_DIR=data/dataset_uploads
DATASET_MAX_UPLOAD_MB=200
MODEL_REGISTRY_DIR=model_registry

# --- Optional: LLM features (email generator, chat assistant) -----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ENABLE_LLM_FEATURES=false
